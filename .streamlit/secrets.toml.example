

# Option 1 (recommended): the daily Parquet export. Public files, no token in the app.
[data]
url = "https://github.com/uditdayani/slogonomics/releases/download/data-latest"

# Option 2: query the Databricks SQL warehouse directly (used when [data] url is absent).

[databricks]
server_hostname = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"   # SQL Warehouses → your warehouse → Connection details
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"           # same page
access_token = "dapi-your-personal-access-token"              # Settings → Developer → Access tokens
catalog = "workspace"                                         # Free Edition's default catalog

[app]
model_version = "v4"                                          # which model version's ratings to show
